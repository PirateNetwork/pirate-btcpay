#syntax=docker/dockerfile:1.2
FROM ubuntu:jammy as dev

RUN apt-get update
RUN DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt-get -y install tzdata
RUN apt-get install -yq curl gnupg2

# pirate-unified-wallet pins 1.90.0 (see its rust-toolchain.toml); the build
# below runs from this repo's root, above that submodule, so rustup would
# otherwise pick whatever "latest stable" it installs instead.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | bash -s -- -y --default-toolchain 1.90.0
RUN apt-get update
RUN apt-get install -yq unzip xz-utils clang cmake git pkg-config libssl-dev libsqlite3-dev

# Ubuntu jammy's protobuf-compiler package is protoc 3.12.4, which errors on
# proto3 optional fields (needs --experimental_allow_proto3_optional) unless
# given protoc >= 3.15. zcash_client_backend's build script needs a modern
# protoc, so install one directly instead of the apt package.
RUN curl -fsSL -o /tmp/protoc.zip https://github.com/protocolbuffers/protobuf/releases/download/v25.1/protoc-25.1-linux-x86_64.zip \
    && unzip -o /tmp/protoc.zip -d /usr/local \
    && rm /tmp/protoc.zip

#syntax=docker/dockerfile:1.2
FROM dev as builder

ENV PATH $PATH:/root/.cargo/bin

COPY . /pirate-btcpay

# Don't assume the host cloned with --recursive - pull whatever submodules
# (pirate-unified-wallet, etc.) are missing or empty in the build context.
RUN cd /pirate-btcpay && git submodule update --init --recursive

RUN cd /pirate-btcpay && cargo b -r -p pirate-btcpay-walletd

FROM ubuntu:jammy
WORKDIR /root
COPY --from=builder /pirate-btcpay/target/release/pirate-btcpay-walletd ./
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*
